# docker compose 环境变量示例（复制为 .env 后按需修改）
# cp .env.example .env

# ---- 运行环境 ----
ENV=dev
DEBUG=true

# ---- 宿主机端口（容器内端口固定：PG 5432 / Redis 6379 / 后端 8000 / 前端 3001）----
POSTGRES_PORT=55434
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8000
FRONTEND_PORT=3001

# ---- PostgreSQL ----
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm123456
POSTGRES_DB=crm

# ---- Redis ----
REDIS_DB=0

# ---- MinIO ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crm

# ---- 后端 ----
# 生产必须替换为强随机值
SECRET_KEY=dev-secret-key-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- EBMS 集成 ----
EBMS_DELIVERY_MODE=spool
EBMS_INGEST_URL=
EBMS_INGEST_TOKEN=
# 生产必须显式设置强随机值
EBMS_INBOUND_TOKEN=

# ---- 前端（构建期写入浏览器端 bundle）----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
