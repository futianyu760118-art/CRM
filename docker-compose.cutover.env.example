# CRM 主写切流配置示例（PAND-307 / PAND-309 R4）
# 用法：cp docker-compose.cutover.env.example .env 后填入真实凭据；凭据只放 .env，不提交仓库。
#
# 切流语义：CRM 为 6 模块唯一业务写侧，EBMS 降为同步/读侧。
# - EBMS_DELIVERY_MODE=http：CRM→EBMS 走 EBMS ingest 端点（默认 spool 仅本地落盘，不交付）
# - crm-worker：docker-compose.yml 内置 Celery worker + beat，每 60s 投递 integration_outbox
# - EBMS_INBOUND_TOKEN：EBMS→CRM 入站令牌（CRM 侧校验）
# - EBMS_INGEST_TOKEN：CRM→EBMS 投递令牌（EBMS 侧校验）

ENV=dev
DEBUG=true

POSTGRES_PORT=55434
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8000
FRONTEND_PORT=3001

POSTGRES_USER=crm
POSTGRES_PASSWORD=crm123456
POSTGRES_DB=crm
REDIS_DB=0
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crm

SECRET_KEY=dev-secret-key-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- 切流：CRM → EBMS ----
EBMS_DELIVERY_MODE=http
EBMS_INGEST_URL=http://host.docker.internal:3010/api/aeos/ingest
# 生产必须显式设置强随机值（与 EBMS 侧 EBMS_INGEST_TOKEN 一致）
EBMS_INGEST_TOKEN=__REPLACE_WITH_EBMS_INGEST_TOKEN__
# 生产必须显式设置强随机值（与 EBMS 侧 EBMS_INBOUND_TOKEN 一致）
EBMS_INBOUND_TOKEN=__REPLACE_WITH_EBMS_INBOUND_TOKEN__

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
